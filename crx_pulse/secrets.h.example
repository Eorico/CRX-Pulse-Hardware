// =====================================================================
//  CRX-Pulse — WiFi credentials  (TEMPLATE)
// =====================================================================
//
//  Copy this file to `secrets.h` in the same folder and fill in your
//  network. `secrets.h` is gitignored; this template is not, so never
//  put a real password in THIS file.
//
//      cp secrets.h.example secrets.h
//
//  Easier: run the desktop WiFi Connector (desktop/), type the SSID and
//  password, and press Compile & Upload. It writes secrets.h for you
//  and flashes the board, so the credentials only ever exist on this
//  machine and on the ESP32.
//
//  The ESP32 only joins 2.4 GHz networks. A 5 GHz-only SSID will never
//  connect, which looks exactly like a wrong password.
// =====================================================================

#pragma once

#define WIFI_SSID      "YOUR_WIFI_NAME"
#define WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

//  Password for the offline fallback access point. When the tank's WiFi
//  is unavailable the device raises its own AP, named CRX-Pulse-XXXXXX
//  after the last three bytes of its MAC, so a phone can join it
//  directly and keep reading. WPA2 requires 8 to 63 characters.
#define AP_PASSWORD    "YOUR_AP_PASSWORD"
